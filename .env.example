# Monster Hunter 3 Ultimate (Wii U) - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_MH3U_*.

# --- PRUDP listeners ---
PN_MH3U_AUTH_PORT=26400
PN_MH3U_SECURE_PORT=26401
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_MH3U_SECURE_HOST=localhost

# --- Database (isolated matchmaking schema only - no ranking/DataStore) ---
PN_MH3U_POSTGRES_URI=postgres://mh3u:mh3u@localhost:5432/mh3u?sslmode=disable

# --- Kerberos / system accounts ---
PN_MH3U_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_MH3U_LOCAL_MODE=1
PN_MH3U_SETTINGS_PATH=settings.json

# Required only when PN_MH3U_LOCAL_MODE is not 1:
PN_MH3U_NEX_TOKEN_AES_KEY=
PN_MH3U_NEX_PASSWORD_SECRET=
